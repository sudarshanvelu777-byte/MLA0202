import pandas as pd
import matplotlib.pyplot as plt
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.preprocessing import LabelEncoder

# Step 1: Create a sample dataset
data = {
    'Outlook': ['Sunny', 'Sunny', 'Overcast', 'Rain', 'Rain',
                'Rain', 'Overcast', 'Sunny', 'Sunny', 'Rain',
                'Sunny', 'Overcast', 'Overcast', 'Rain'],
    'Temperature': ['Hot', 'Hot', 'Hot', 'Mild', 'Cool',
                    'Cool', 'Cool', 'Mild', 'Cool', 'Mild',
                    'Mild', 'Mild', 'Hot', 'Mild'],
    'Humidity': ['High', 'High', 'High', 'High', 'Normal',
                 'Normal', 'Normal', 'High', 'Normal', 'Normal',
                 'Normal', 'High', 'Normal', 'High'],
    'Wind': ['Weak', 'Strong', 'Weak', 'Weak', 'Weak',
             'Strong', 'Strong', 'Weak', 'Weak', 'Weak',
             'Strong', 'Strong', 'Weak', 'Strong'],
    'Play': ['No', 'No', 'Yes', 'Yes', 'Yes',
             'No', 'Yes', 'No', 'Yes', 'Yes',
             'Yes', 'Yes', 'Yes', 'No']
}

df = pd.DataFrame(data)

# Step 2: Encode categorical values into numbers
encoders = {}
df_encoded = df.copy()

for column in df.columns:
    encoders[column] = LabelEncoder()
    df_encoded[column] = encoders[column].fit_transform(df[column])

X = df_encoded.drop('Play', axis=1)
y = df_encoded['Play']

# Step 3: Build the ID3 decision tree
model = DecisionTreeClassifier(
    criterion='entropy',
    random_state=0
)
model.fit(X, y)

# Step 4: Visualize the decision tree
plt.figure(figsize=(14, 8))
plot_tree(
    model,
    feature_names=X.columns,
    class_names=encoders['Play'].classes_,
    filled=True,
    rounded=True
)
plt.title("ID3 Decision Tree")
plt.show()

# Step 5: Classify a new sample
new_sample = pd.DataFrame([{
    'Outlook': 'Sunny',
    'Temperature': 'Cool',
    'Humidity': 'Normal',
    'Wind': 'Weak'
}])

# Encode the new sample using the existing encoders
new_encoded = new_sample.copy()

for column in new_sample.columns:
    new_encoded[column] = encoders[column].transform(
        new_sample[column]
    )

prediction = model.predict(new_encoded)

result = encoders['Play'].inverse_transform(prediction)

print("New Sample:", new_sample.to_dict(orient='records')[0])
print("Predicted Class:", result[0])

